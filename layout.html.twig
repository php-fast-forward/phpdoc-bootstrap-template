<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8">
    {% block head %}
        <title>{% block title %}{{ project.name }}{% endblock %}</title>
    {% endblock %}

    {% set currentDestination = destinationPath|default('') %}
    {% if (currentDestination is empty) and env is not null %}
        {% set currentDestination = env.currentFileDestination|default('') %}
    {% endif %}

    {% set normalizedDestination = currentDestination
        |split('#')|first
        |split('?')|first
        |replace({'./': '', '.\\': ''})
        |trim('/')
    %}

    {% set destinationDepth = normalizedDestination ? (normalizedDestination|split('/')|length - 1) : 0 %}
    {% set currentDocumentHref = normalizedDestination ends with '.html' ? normalizedDestination : (normalizedDestination ? normalizedDestination ~ '.html' : 'index.html') %}
    {% set baseHref = './' %}

    {% if destinationDepth > 0 %}
        {% set baseSegments = [] %}
        {% for i in 1..destinationDepth %}
            {% set baseSegments = baseSegments|merge(['../']) %}
        {% endfor %}
        {% set baseHref = baseSegments|join('') %}
    {% endif %}

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <base href="{{ baseHref }}">

    {% block stylesheets %}
        <!-- Bootstrap -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <!-- Font Awesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/css/all.min.css">
        

        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/default.min.css">

        <link rel="stylesheet" href="{{ path('css/base.css') }}">
    {% endblock %}
</head>
<body class="ff-docs">
    <a class="ff-skip-link" href="{{ currentDocumentHref }}#content">Skip to documentation</a>
    <div id="main-wrapper">
        {% include 'components/header.html.twig' %}

        <main id="content" tabindex="-1" class="container-fluid">
            <div class="row min-vh-100">
                <aside class="ff-docs-rail col-12 col-lg-3 col-xl-2 px-0" data-bs-theme="dark">
                    <details class="ff-docs-navigation" open>
                        <summary>Documentation navigation</summary>
                    <div class="navigation h-100">
                        {% include 'components/sidebar.html.twig' %}
                    </div>
                    </details>
                </aside>

                <div class="col-12 col-lg-9 col-xl-10">
                    <div class="py-4 py-xl-5">
                        <div class="container-fluid">
                            {% set hasOnThisPage = block('on_this_page') is defined or node.headerNodes is defined %}

                            <div class="row g-4">
                                <div class="{{ hasOnThisPage ? 'col-12 col-xl-9' : 'col-12' }}">
                                    <div class="ff-docs-article bg-body p-4 p-xl-5">
                                        {% block content %}{% endblock %}
                                    </div>
                                </div>

                                {% if hasOnThisPage %}
                                    <aside class="col-12 col-xl-3 d-none d-xl-block">
                                        <div class="position-sticky ff-docs-outline">
                                            <div class="bg-body-tertiary border rounded-4 p-3 shadow-sm">
                                                <div class="d-flex align-items-center gap-2 text-uppercase fw-semibold small text-body-secondary mb-3">
                                                    <i class="fas fa-list-ul text-primary"></i>
                                                    <span>On this page</span>
                                                </div>

                                                {% if block('on_this_page') is defined %}
                                                    {{ block('on_this_page') }}
                                                {% else %}
                                                    <nav data-guide-outline aria-label="On this page"></nav>
                                                {% endif %}
                                                <figure class="ff-docs-companion">
                                                    <img src="{{ path('images/dash-reading.png') }}" alt="Dash reading the documentation" width="188" height="282" loading="lazy">
                                                    <figcaption>Build with clarity. Keep moving forward.</figcaption>
                                                </figure>
                                            </div>
                                        </div>
                                    </aside>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        {% include 'components/search-results.html.twig' %}
    </div>

    <a id="back-to-top" title="Back to Top" href="{{ currentDocumentHref }}#content" aria-label="Back to documentation"><i class="fa fa-chevron-up"></i></a>

    {% block javascripts %}
        <!-- jQuery -->
        <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
        <!-- Bootstrap Bundle (includes Popper) -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

        <script src="https://cdn.jsdelivr.net/npm/fuse.js@3.4.6"></script>
        <script src="https://cdn.jsdelivr.net/npm/css-vars-ponyfill@2"></script>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

        <script src="{{ path('js/template.js') }}"></script>
        <script src="{{ path('js/search.js') }}"></script>
        <script defer src="{{ path('js/searchIndex.js') }}"></script>
    {% endblock %}
</body>
</html>
