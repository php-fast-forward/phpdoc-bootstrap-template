{% extends 'base.html.twig' %}

{% set filesWithMarkers = project.files|filter(file => file.markers is not empty) %}

{% block title %}
    {{ project.name }} &raquo; Markers
{% endblock %}

{% block content %}
    <section>
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="{{ path('/') }}">Home</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Markers</li>
            </ol>
        </nav>

        <div class="d-flex align-items-center gap-2 mb-4">
            <i class="fas fa-bookmark text-info"></i>
            <h2 class="h3 mb-0">Markers</h2>
        </div>

        {% if filesWithMarkers is not empty %}
            <section class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-body-tertiary border-0 d-flex align-items-center gap-2">
                    <i class="fas fa-list-ul text-primary"></i>
                    <span class="fw-semibold">Table of contents</span>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>File</th>
                                    <th class="text-end">Markers</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for file in filesWithMarkers %}
                                    {% if file.markers.count > 0 %}
                                        <tr>
                                            <td>
                                                <a href="{{ target_path }}#{{ file.path }}" class="text-decoration-none">
                                                    {{ file.path }}
                                                </a>
                                            </td>
                                            <td class="text-end">
                                                <span class="badge text-bg-secondary">{{ file.markers.count }}</span>
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        {% else %}
            <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
                <i class="fas fa-check-circle"></i>
                <div>No markers have been found in this project.</div>
            </div>
        {% endif %}

        <div class="d-grid gap-4">
            {% for file in filesWithMarkers %}
                <section id="{{ file.path }}" class="card border-0 shadow-sm">
                    <div class="card-header bg-body-tertiary border-0 d-flex align-items-center gap-2">
                        <i class="fas fa-file-code text-secondary"></i>
                        <span class="fw-semibold">
                            <abbr title="{{ file.path }}" class="text-decoration-none">{{ file.name }}</abbr>
                        </span>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Type</th>
                                        <th>Line</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for marker in file.markers %}
                                        <tr>
                                            <td>
                                                <span class="badge text-bg-warning">{{ marker.type }}</span>
                                            </td>
                                            <td>{{ marker.line }}</td>
                                            <td>{{ marker.message }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            {% endfor %}
        </div>
    </section>
{% endblock %}