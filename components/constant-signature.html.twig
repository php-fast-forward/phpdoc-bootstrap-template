<code class="d-inline-flex flex-wrap align-items-center gap-2 px-3 py-2 rounded-3 bg-body-tertiary border{% if node.deprecated %} text-body-secondary text-decoration-line-through{% endif %}">
    <span class="badge text-bg-light border text-dark">
        {{ node.visibility }}
    </span>

    {% if node.final %}
        <span class="badge text-bg-danger">final</span>
    {% endif %}

    <span class="text-info-emphasis">
        {{ not node.type ? 'mixed' : node.type|route('class:short')|join('|')|raw }}
    </span>

    <span class="text-warning-emphasis fw-semibold">
        {{ node.name }}
    </span>

    <span class="text-body-secondary">=</span>

    <span class="text-success-emphasis">
        {{ node.value | default('""') }}
    </span>
</code>