<code class="d-inline-flex flex-wrap align-items-center gap-2 px-3 py-2 rounded-3 bg-body-tertiary border{% if hook.deprecated %} text-body-secondary text-decoration-line-through{% endif %}">
    <span class="badge text-bg-light border text-dark">
        {{ hook.visibility }}
    </span>

    {% if hook.final %}
        <span class="badge text-bg-danger">final</span>
    {% endif %}

    {% if hook.name != 'set' %}
        <span class="text-info-emphasis">
            {{ not property.type ? 'mixed' : property.type|route('class:short')|join('|')|raw }}
        </span>
    {% endif %}

    <span class="text-primary fw-semibold">
        {{ hook.name }}
    </span>
</code>