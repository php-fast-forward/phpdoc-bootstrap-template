<div class="mb-5">
    <div class="d-flex align-items-center gap-3 mb-3">
        <div class="bg-info-subtle text-info rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 3rem; height: 3rem;">
            <i class="fas fa-plug"></i>
        </div>
        <div>
            <h2 class="display-5 mb-1">{{ node.name }}</h2>
            <div class="text-body-secondary">Interface</div>
        </div>
    </div>

    {% if node.parent is not empty %}
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="text-body-secondary">extends</span>
            {% for interface in node.parent %}
                <span class="badge rounded-pill text-bg-info">
                    {{ interface|route('class:short') }}
                </span>
            {% endfor %}
        </div>
    {% endif %}

    {% if usesPackages %}
        <nav aria-label="breadcrumb" class="mb-0">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item text-body-secondary">in package</li>
                {% for breadcrumb in packages(node) %}
                    <li class="breadcrumb-item">
                        <a href="{{ link(breadcrumb) }}" class="text-decoration-none">{{ breadcrumb.name }}</a>
                    </li>
                {% endfor %}
            </ol>
        </nav>
    {% endif %}
</div>