{% set tags = node.tags|filter((v, k) => k not in ['var', 'param', 'property', 'property-read', 'property-write', 'method', 'return', 'package', 'api', 'deprecated']) %}

{% if tags|length > 0 and tags|first|length > 0 %}
    <section class="mt-4">
        <div class="d-flex align-items-center gap-2 mb-3">
            <i class="fas fa-tags text-info"></i>
            <h5 class="h6 text-uppercase text-body-secondary fw-semibold mb-0" id="tags">
                Tags
                {{ include('components/headerlink.html.twig', {'on': node, 'at': 'tags'}, with_context = false) }}
            </h5>
        </div>

        <div class="d-grid gap-3">
            {% for name, seriesOfTag in tags %}
                {% for tag in seriesOfTag %}
                    <div class="card border-0 bg-body-tertiary shadow-sm">
                        <div class="card-body p-3">
                            <div class="mb-2">
                                <span class="badge text-bg-info">{{ name }}</span>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mb-2">
                                {% if tag.version %}
                                    <span class="badge text-bg-light border">{{ tag.version }}</span>
                                {% endif %}

                                {% if tag.type %}
                                    <span class="badge text-bg-light border">
                                        {{ tag.type|route('class:short')|join('|')|raw }}
                                    </span>
                                {% endif %}

                                {% if tag.reference %}
                                    <span class="badge text-bg-light border">
                                        {{ tag.reference|route('class:short')|join('|')|raw }}
                                    </span>
                                {% endif %}
                            </div>

                            {% if tag.link %}
                                <div>
                                    <a class="text-decoration-none" href="{{ tag.link }}">
                                        {% if not tag.description.empty %}
                                            {{ tag.description | description | markdown }}
                                        {% else %}
                                            {{ tag.link }}
                                        {% endif %}
                                    </a>
                                </div>
                            {% else %}
                                <div>
                                    {{ include('components/description.html.twig', {'node': tag}) }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    </section>
{% endif %}