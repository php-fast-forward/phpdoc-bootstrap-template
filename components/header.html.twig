<header id="header" class="sticky-top" data-bs-theme="dark">
    <nav class="navbar ff-docs-header navbar-expand-lg" aria-label="Documentation toolbar">
        <div class="container-fluid gap-3">
            <a class="navbar-brand ff-docs-brand" href="{{ path('/') }}" title="{{ project.name }}">
                <img src="{{ path('images/fast-forward-logo-dark.svg') }}" alt="PHP Fast Forward" width="200" height="80">
                <span class="ff-docs-project">{{ project.name }}</span>
            </a>
            <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#header-nav" aria-controls="header-nav" aria-expanded="false" aria-label="Toggle toolbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div id="header-nav" class="collapse navbar-collapse gap-3">
                <div class="me-auto">{% include 'components/topnav.html.twig' %}</div>
                {% include 'components/search.html.twig' %}
                <button class="ff-docs-theme" type="button" data-reading-theme-toggle aria-pressed="false" hidden>Navy reading surface</button>
            </div>
        </div>
    </nav>
</header>
