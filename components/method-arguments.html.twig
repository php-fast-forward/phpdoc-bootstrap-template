{% if node.arguments|length > 0 %}
    <section class="mt-4">
        <div class="d-flex align-items-center gap-2 mb-3">
            <i class="fas fa-sliders-h text-info"></i>
            <h5 class="h6 text-uppercase text-body-secondary fw-semibold mb-0">Parameters</h5>
        </div>

        <div class="d-grid gap-3">
            {% for argument in node.arguments %}
                <div class="card border-0 bg-body-tertiary shadow-sm">
                    <div class="card-body p-3">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <code class="text-primary fw-semibold mb-0">${{ argument.name }}</code>

                            <span class="text-body-secondary">:</span>

                            <span class="badge text-bg-light border text-dark">
                                {{ argument.type|route('class:short')|join('|')|raw }}
                            </span>

                            {% if argument.default is not null %}
                                <span class="text-body-secondary">=</span>
                                <code class="text-success-emphasis mb-0">{{ argument.default | expression }}</code>
                            {% endif %}
                        </div>

                        <div>
                            {{ include('components/description.html.twig', {'node': argument, 'useCard': false}) }}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
{% endif %}