{% set useCard = useCard is defined ? useCard : true %}
{% set sectionClass = sectionClass is defined ? sectionClass : 'mt-2' %}
{% set bodyClass = bodyClass is defined ? bodyClass : 'p-3' %}

{% if node.description and not node.description.empty %}
    <section class="{{ sectionClass }}">
        {% if useCard %}
            <div class="card border-0 bg-body-tertiary shadow-sm">
                <div class="card-body {{ bodyClass }}">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="fas fa-align-left text-primary"></i>
                        <h3 class="h6 text-uppercase text-body-secondary fw-semibold mb-0">Description</h3>
                    </div>

                    <div>
                        {{ node.description|description|markdown }}
                    </div>
                </div>
            </div>
        {% else %}
            <div>
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="fas fa-align-left text-primary"></i>
                    <h3 class="h6 text-uppercase text-body-secondary fw-semibold mb-0">Description</h3>
                </div>

                <div>
                    {{ node.description|description|markdown }}
                </div>
            </div>
        {% endif %}
    </section>
{% endif %}